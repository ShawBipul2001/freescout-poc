# Copy to .env (docker compose reads it automatically)

# Your timezone, e.g. Europe/London
TZ=Etc/UTC

ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASS=Admin12345
DB_PASS=freescoutpass
DB_ROOT_PASS=rootpassword

# Portal channel:
#   email = free, uses FreeScout core only (ticket created from an inbound email)
#   api   = needs the API & Webhooks module; enables ticket history, replies, live updates
TICKET_CHANNEL=email

# Filled in after installing the API & Webhooks module (Manage > Settings > API & Webhooks)
FS_API_KEY=
FS_WEBHOOK_SECRET=
FS_MAILBOX_ID=1
